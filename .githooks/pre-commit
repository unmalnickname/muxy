#!/bin/bash
# Agent Workflow: Pre-commit hook
# Runs before every commit — fast verification gates only.
# Reports status to .muxy/hook-status.json for Muxy pipeline panel.

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
mkdir -p .muxy

write_status() {
    local id="$1"; local name="$2"; local status="$3"; local dur="${4:-None}"
    python3 "$SCRIPT_DIR/pipeline-status.py" \
        ".muxy/hook-status.json" ".muxy/pipeline-history.json" \
        "pre-commit" "$id" "$name" "$status" "$dur" "$TIMESTAMP"
}

run_step() {
    local id="$1"; local name="$2"; shift 2
    write_status "$id" "$name" "started"
    local start_time
    start_time=$(date +%s.%N 2>/dev/null || date +%s)
    if "$@" 2>/dev/null; then
        local end_time
        end_time=$(date +%s.%N 2>/dev/null || date +%s)
        local dur
        dur=$(awk "BEGIN { printf \"%.2f\", $end_time - $start_time }" 2>/dev/null || echo 0)
        write_status "$id" "$name" "passed" "$dur"
        return 0
    else
        local end_time
        end_time=$(date +%s.%N 2>/dev/null || date +%s)
        local dur
        dur=$(awk "BEGIN { printf \"%.2f\", $end_time - $start_time }" 2>/dev/null || echo 0)
        write_status "$id" "$name" "failed" "$dur"
        return 1
    fi
}

echo "=== Pre-commit: Verification Gate ==="
write_status "hook" "Pre-commit Hook" "started"

# 0. Pre-work enforcement
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

# Check we're not on main/master/develop
if [[ "$BRANCH" == "main" || "$BRANCH" == "master" || "$BRANCH" == "develop" ]]; then
    echo ""
    echo "  ⛔ Commit on $BRANCH is blocked."
    echo "     Create a feature branch first:"
    echo "       git checkout -b {type}/{agent}/{description}"
    echo ""
    echo "     Examples:"
    echo "       feature/opencode/add-auth"
    echo "       fix/claude-code/login-crash"
    echo ""
    exit 1
fi

# Check branch follows convention
if ! echo "$BRANCH" | grep -qE "^(feature|fix|refactor|chore|docs|test|hotfix)/[a-z0-9._-]+/.+"; then
    echo ""
    echo "  ⛔ Branch name doesn't follow convention:"
    echo "     $BRANCH"
    echo ""
    echo "     Expected: {type}/{agent}/{description}"
    echo "     Example:  feature/opencode/add-auth"
    echo ""
    exit 1
fi

# Check .muxy/task-context.json exists
if [ ! -f ".muxy/task-context.json" ]; then
    echo ""
    echo "  ⚠️  No task context set."
    echo "     Set one from Muxy's Health Panel, or create the file:"
    echo '     echo '"'"'{"taskType":"feature","taskDescription":"...","recommendedSkills":[]}'"'"' > .muxy/task-context.json'
    echo ""
    echo "     Without context, the agent won't know what to optimize for."
fi

# Check Sentrux baseline freshness
if [ -f ".sentrux/baseline.json" ]; then
    BASELINE_AGE=$(($(date +%s) - $(stat -f "%m" ".sentrux/baseline.json" 2>/dev/null || stat -c "%Y" ".sentrux/baseline.json" 2>/dev/null || echo 0)))
    if [ "$BASELINE_AGE" -gt 604800 ] 2>/dev/null; then  # 7 days
        echo ""
        echo "  ⚠️  Sentrux baseline is stale (over 7 days old)."
        echo "     Refresh it: sentrux gate --save ."
        echo ""
    fi
fi

echo ""

# 1. Detect running agent
AGENT="unknown"
if [ -n "$OPENCODE_ACTIVE" ]; then AGENT="opencode"
elif [ -n "$CLAUDE_CODE_ACTIVE" ]; then AGENT="claude-code"
elif [ -n "$HERMES_ACTIVE" ]; then AGENT="hermes"
elif [ -n "$PI_AGENT_ACTIVE" ]; then AGENT="pi"
fi
echo "[agent] $AGENT"

# 2. Staged files
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED" ]; then
    echo "[skip] no staged files"
    write_status "hook" "Pre-commit Hook" "skipped"
    exit 0
fi

# 3. Language-detected verification
FAILED=0

if [ -f "package.json" ]; then
    if command -v bun &>/dev/null; then
        [ -f "eslint.config.mjs" ] && run_step "lint" "Lint (bun)" bun run lint --quiet || FAILED=1
        [ -f "tsconfig.json" ] && run_step "typecheck" "Type Check" bun run type-check || FAILED=1
    elif command -v npm &>/dev/null; then
        [ -f "eslint.config.mjs" ] && run_step "lint" "Lint (npm)" npx eslint --quiet $STAGED || FAILED=1
    fi
fi

if [ -f "Cargo.toml" ]; then
    run_step "fmt" "Cargo Format" cargo fmt --check || FAILED=1
    run_step "check" "Cargo Check" cargo check || FAILED=1
fi

if [ -f "pubspec.yaml" ]; then
    run_step "dartfmt" "Dart Format" dart format --set-exit-if-changed $STAGED || FAILED=1
fi

if [ -f "pyproject.toml" ] || [ -f "requirements.txt" ]; then
    if command -v ruff &>/dev/null; then
        run_step "ruff" "Ruff Check" ruff check $STAGED || FAILED=1
        run_step "rufffmt" "Ruff Format" ruff format --check $STAGED || FAILED=1
    fi
    if command -v mypy &>/dev/null; then
        run_step "mypy" "Mypy" mypy $STAGED || FAILED=1
    fi
fi

if ls *.xcodeproj *.xcworkspace 2>/dev/null | grep -q .; then
    if command -v swiftformat &>/dev/null; then
        run_step "swiftfmt" "SwiftFormat" swiftformat --lint . || {
            echo "[FAIL] swiftformat issues found. Run: swiftformat ."
            FAILED=1
        }
    fi
    if command -v swiftlint &>/dev/null; then
        run_step "swiftlint" "SwiftLint" swiftlint --strict . || {
            echo "[FAIL] swiftlint issues found."
            FAILED=1
        }
    fi
    if [ -f "scripts/checks.sh" ]; then
        run_step "checks" "Project Checks" scripts/checks.sh || {
            echo "[FAIL] scripts/checks.sh failed."
            FAILED=1
        }
    fi
fi

# 4. Secret scan
if command -v gitleaks &>/dev/null; then
    run_step "gitleaks" "Gitleaks" gitleaks protect --staged -v || {
        echo "[FAIL] Secrets detected!"
        FAILED=1
    }
fi

# 5. Sentrux
if command -v sentrux &>/dev/null; then
    run_step "sentrux" "Sentrux" sentrux gate . || {
        echo "[sentrux] WARNING: quality degraded"
    }
fi

if [ "$FAILED" -eq 1 ]; then
    write_status "hook" "Pre-commit Hook" "failed"
    echo "=== Pre-commit FAILED ==="
    exit 1
fi

write_status "hook" "Pre-commit Hook" "passed"
echo "=== Pre-commit Passed ==="
