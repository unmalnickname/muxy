#!/bin/bash
set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

echo "=== Pre-commit: Verification Gate ==="

# 1. Detect agent
AGENT="unknown"
if [ -n "$OPENCODE_ACTIVE" ]; then AGENT="opencode"
elif [ -n "$CLAUDE_CODE_ACTIVE" ]; then AGENT="claude-code"
fi
echo "[agent] $AGENT"

# 2. Staged files check
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED" ]; then
    echo "[skip] no staged files"
    exit 0
fi

# 3. Swift checks via project's own script
echo "[swift] running formatting check..."
swiftformat --lint . --quiet || {
    echo "[FAIL] Formatting issues found. Run: swiftformat ."
    exit 1
}

if command -v swiftlint &>/dev/null; then
    echo "[swift] running lint..."
    swiftlint lint --strict --quiet || {
        echo "[FAIL] Linting issues found. Run: swiftlint lint --fix"
        exit 1
    }
fi

echo "[swift] checking build..."
swift build 2>&1 | tail -5 || {
    echo "[FAIL] Build failed"
    exit 1
}

# 4. Secret scan
if command -v gitleaks &>/dev/null; then
    echo "[gitleaks] scanning staged..."
    gitleaks protect --staged -v 2>&1 || {
        echo "[FAIL] Secrets detected in staged files"
        exit 1
    }
fi

# 5. Sentrux quality gate
if command -v sentrux &>/dev/null && [ -f ".sentrux/rules.toml" ]; then
    echo "[sentrux] quality gate..."
    sentrux gate . 2>&1 || echo "[sentrux] WARNING: quality score degraded"
fi

echo "=== Pre-commit Passed ==="
