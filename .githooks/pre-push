#!/bin/bash
# Agent Workflow: Pre-push hook
# Full validation before allowing push to remote.
# Reports status to .muxy/hook-status.json for Muxy pipeline panel.

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
REMOTE="${1:-origin}"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
mkdir -p .muxy

write_status() {
    local id="$1"; local name="$2"; local status="$3"; local dur="${4:-None}"
    python3 "$SCRIPT_DIR/pipeline-status.py" \
        ".muxy/hook-status.json" ".muxy/pipeline-history.json" \
        "pre-push" "$id" "$name" "$status" "$dur" "$TIMESTAMP"
}

echo "=== Pre-push: Full Validation Gate ==="
echo "[branch] $BRANCH → $REMOTE"
write_status "hook" "Pre-push Hook" "started"

# 1. Detect agent from branch name
AGENT=$(echo "$BRANCH" | awk -F/ '{print $2}')
echo "[agent] ${AGENT:-unknown}"

# 2. Validate branch naming convention
if [[ "$BRANCH" != "master" && "$BRANCH" != "main" && "$BRANCH" != "develop" ]]; then
    if ! echo "$BRANCH" | grep -qE "^(feature|fix|refactor|chore|docs|test|hotfix)/[a-z0-9._-]+/.+"; then
        echo "[error] Branch name must follow convention: {type}/{agent}/{description}"
        write_status "branch" "Branch Convention" "failed"
        write_status "hook" "Pre-push Hook" "failed"
        exit 1
    fi
fi
write_status "branch" "Branch Convention" "passed"

# 3. Full project verification
FAILED=0

run_step() {
    local id="$1"; local name="$2"; shift 2
    write_status "$id" "$name" "started"
    local start_time
    start_time=$(date +%s 2>/dev/null)
    if "$@" 2>/dev/null; then
        local end_time
        end_time=$(date +%s 2>/dev/null)
        local dur=$(( end_time - start_time ))
        write_status "$id" "$name" "passed" "$dur"
        return 0
    else
        local end_time
        end_time=$(date +%s 2>/dev/null)
        local dur=$(( end_time - start_time ))
        write_status "$id" "$name" "failed" "$dur"
        return 1
    fi
}

if [ -f "package.json" ]; then
    if command -v bun &>/dev/null; then
        if grep -q '"validate"' package.json 2>/dev/null; then
            run_step "validate" "Full Validate" bun run validate || FAILED=1
        else
            [ -f "eslint.config.mjs" ] && run_step "lint" "Lint" bun run lint || FAILED=1
            [ -f "tsconfig.json" ] && run_step "typecheck" "Type Check" bun run type-check || FAILED=1
        fi
    fi
fi

if [ -f "Cargo.toml" ]; then
    run_step "test" "Cargo Test" cargo test || FAILED=1
fi

if [ -f "pubspec.yaml" ]; then
    run_step "analyze" "Flutter Analyze" flutter analyze || FAILED=1
    run_step "test" "Flutter Test" flutter test || FAILED=1
fi

if [ -f "pyproject.toml" ]; then
    if command -v pytest &>/dev/null; then
        run_step "test" "Python Tests" pytest || FAILED=1
    fi
fi

if ls *.xcodeproj *.xcworkspace 2>/dev/null | grep -q .; then
    if command -v swiftformat &>/dev/null; then
        run_step "swiftfmt" "SwiftFormat" swiftformat --lint . || {
            echo "[fail] swiftformat issues."; FAILED=1
        }
    fi
    if command -v swiftlint &>/dev/null; then
        run_step "swiftlint" "SwiftLint" swiftlint --strict . || {
            echo "[fail] swiftlint issues."; FAILED=1
        }
    fi
    if [ -f "scripts/checks.sh" ]; then
        run_step "checks" "Project Checks" scripts/checks.sh || {
            echo "[fail] scripts/checks.sh failed."; FAILED=1
        }
    fi
    if command -v swift &>/dev/null; then
        run_step "swifttest" "Swift Test" swift test || {
            echo "[fail] swift test failed."; FAILED=1
        }
    fi
fi

# 4. Sentrux full quality gate
if command -v sentrux &>/dev/null; then
    run_step "sentrux" "Sentrux" sentrux check . || {
        echo "[fail] Sentrux rules violated."
        FAILED=1
    }
fi

# 5. Check for uncommitted changes
if [ -n "$(git status --porcelain)" ]; then
    echo "[warn] Uncommitted changes present (not blocking)"
fi

# 6. Secret scan (Gitleaks)
if command -v gitleaks &>/dev/null; then
    run_step "gitleaks" "Gitleaks" gitleaks detect --source . -v || {
        echo "[fail] Secrets found!"
        FAILED=1
    }
fi

if [ "$FAILED" -eq 1 ]; then
    write_status "hook" "Pre-push Hook" "failed"
    echo "=== Pre-push FAILED ==="
    exit 1
fi

write_status "hook" "Pre-push Hook" "passed"
echo "=== Pre-push Passed ==="
