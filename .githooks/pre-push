#!/bin/bash
set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)
REMOTE="${1:-origin}"

echo "=== Pre-push: Full Validation Gate ==="
echo "[branch] $BRANCH -> $REMOTE"

# 1. Branch naming convention
if [[ "$BRANCH" != "master" && "$BRANCH" != "main" && "$BRANCH" != "develop" ]]; then
    if ! echo "$BRANCH" | grep -qE "^(feature|fix|refactor|chore|docs|test|hotfix)/[a-z0-9._-]+/.+"; then
        echo "[error] Branch name format: {type}/{agent}/{description}"
        echo "        e.g. feature/opencode/add-auth, fix/claude-code/login-crash"
        exit 1
    fi
fi

# 2. Hotfix checks
if echo "$BRANCH" | grep -qE "^hotfix/"; then
    if [[ "$REMOTE" != "origin" ]]; then
        echo "[hotfix] targeting $REMOTE -- hotfixes should push to origin"
    fi
    echo "[hotfix] pushing directly"
fi

# 3. Swift build + test via project script
echo "[swift] running checks..."
scripts/checks.sh || {
    echo "[fail] scripts/checks.sh failed"
    exit 1
}

# 4. Sentrux full quality gate
if command -v sentrux &>/dev/null && [ -f ".sentrux/rules.toml" ]; then
    echo "[sentrux] running quality gate..."
    sentrux gate . || {
        echo "[fail] Quality degraded from baseline"
        echo "       Run: sentrux gate . --save  (to accept new baseline)"
        exit 1
    }
fi

# 5. Secret scan
if command -v gitleaks &>/dev/null; then
    echo "[gitleaks] scanning repo..."
    gitleaks detect --source . -v 2>&1 || {
        echo "[FAIL] Secrets found in repository"
        exit 1
    }
fi

# 6. Branch push guard
if [[ "$BRANCH" == "master" || "$BRANCH" == "main" ]]; then
    if [ -z "$CI" ]; then
        echo "[error] Direct push to $BRANCH is not allowed"
        echo "       Use a hotfix branch or release PR instead"
        exit 1
    fi
fi

# 7. Uncommitted changes warning
if [ -n "$(git status --porcelain)" ]; then
    echo "[warn] Uncommitted changes present (not blocking)"
fi

echo "=== Pre-push Passed ==="
